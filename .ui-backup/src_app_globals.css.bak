@import "tailwindcss";

/*
  Veyro — clean, Coursera-style light theme
  brand     #0056d2  primary blue      brand-dark #00419e
  brand-50  #f0f6ff  tinted sections   brand-100  #e3eeff
  ink       #1f1f1f  text              muted      #5b6780
  line      #dae1ed  borders           soft       #f5f7f8  grey bands
  success   #1b7d4f  completion        danger     #c4122f
*/
@theme {
  --color-brand: #0056d2;
  --color-brand-dark: #00419e;
  --color-brand-50: #f0f6ff;
  --color-brand-100: #e3eeff;
  --color-ink: #1f1f1f;
  --color-muted: #5b6780;
  --color-line: #dae1ed;
  --color-soft: #f5f7f8;
  --color-success: #1b7d4f;
  --color-success-50: #e9f6ef;
  --color-danger: #c4122f;

  --font-sans: "Source Sans 3 Variable", "Source Sans Pro", ui-sans-serif, system-ui, sans-serif;
}

@layer base {
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    background: #fff;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: var(--color-brand-100);
  }
  :focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

@layer components {
  .h-display {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .h-section {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background-color 120ms ease,
      color 120ms ease,
      border-color 120ms ease,
      box-shadow 120ms ease;
  }
  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .btn-primary {
    background: var(--color-brand);
    color: #fff;
    border: 1px solid var(--color-brand);
  }
  .btn-primary:hover:not(:disabled) {
    background: var(--color-brand-dark);
    border-color: var(--color-brand-dark);
  }
  .btn-outline {
    background: #fff;
    color: var(--color-brand);
    border: 1px solid var(--color-brand);
  }
  .btn-outline:hover:not(:disabled) {
    background: var(--color-brand-50);
  }
  .btn-white {
    background: #fff;
    color: var(--color-brand);
    border: 1px solid #fff;
  }
  .btn-white:hover:not(:disabled) {
    background: var(--color-brand-50);
  }
  .btn-lg {
    min-height: 3.25rem;
    padding: 0.75rem 1.75rem;
    font-size: 1.05rem;
  }

  .card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
  }
  .card-hover {
    transition:
      box-shadow 150ms ease,
      border-color 150ms ease;
  }
  .card-hover:hover {
    border-color: #c4cfe0;
    box-shadow: 0 6px 18px rgb(31 31 31 / 0.12);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    padding: 0.4rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    background: #fff;
    border: 1px solid #b5bfd0;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .chip:hover {
    background: var(--color-soft);
  }
  .chip[aria-current="true"] {
    color: #fff;
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .field {
    display: block;
    width: 100%;
    min-height: 2.9rem;
    padding: 0.6rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid #929fb3;
    background: #fff;
    color: var(--color-ink);
    font-size: 1rem;
  }
  .field::placeholder {
    color: #6b7589;
  }
  .field:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 0;
    border-color: var(--color-brand);
  }
  .field-label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .link {
    color: var(--color-brand);
    font-weight: 600;
  }
  .link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .skeleton {
    background: linear-gradient(90deg, #eef1f5, #f7f8fa, #eef1f5);
    background-size: 200% 100%;
    animation: shimmer 1.5s linear infinite;
    border-radius: 0.5rem;
  }
  @keyframes shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  /* Reading lessons */
  .prose-reading {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #333;
    max-width: 72ch;
  }
  .prose-reading > * + * {
    margin-top: 1em;
  }
  .prose-reading h2 {
    font-size: 1.45rem;
    line-height: 1.25;
    font-weight: 600;
    margin-top: 1.8em;
    color: var(--color-ink);
  }
  .prose-reading h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 1.5em;
    color: var(--color-ink);
  }
  .prose-reading ul,
  .prose-reading ol {
    padding-left: 1.4em;
  }
  .prose-reading ul {
    list-style: disc;
  }
  .prose-reading ol {
    list-style: decimal;
  }
  .prose-reading li + li {
    margin-top: 0.4em;
  }
  .prose-reading strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .prose-reading a {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .prose-reading pre {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.92rem;
    line-height: 1.55;
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 1rem 1.15rem;
    overflow-x: auto;
  }
  .prose-reading code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
  .prose-reading table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .prose-reading th,
  .prose-reading td {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-line);
  }
  .prose-reading th {
    font-weight: 600;
    background: var(--color-soft);
  }
}

/* ---------------------------------------------------------------- spatial hero */
@layer components {
  .spatial-stage {
    perspective: 1100px;
    perspective-origin: 50% 45%;
  }
  .spatial-scene {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 50%;
    --gy: 40%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    will-change: transform;
  }
  .spatial-layer {
    transform-style: preserve-3d;
    transform: translateZ(var(--z, 0px));
  }
  .spatial-in {
    transform-style: preserve-3d;
    animation: spatial-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .spatial-glass {
    color: var(--color-ink);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.96), rgb(255 255 255 / 0.86));
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(16 24 64 / 0.08),
      0 24px 48px -12px rgb(16 40 120 / 0.35);
    backdrop-filter: blur(16px) saturate(170%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
  }
  .spatial-glare {
    background: radial-gradient(circle at var(--gx) var(--gy), rgb(255 255 255 / 0.35), transparent 45%);
    mix-blend-mode: soft-light;
  }
  .spatial-float-a {
    animation: spatial-float 6s ease-in-out infinite;
  }
  .spatial-float-b {
    animation: spatial-float 7.5s ease-in-out -2s infinite;
  }
  .spatial-float-c {
    animation: spatial-float 9s ease-in-out -4s infinite;
  }
  .spatial-spin {
    animation: spatial-spin 80s linear infinite;
  }
  .spatial-photo {
    animation: spatial-zoom 18s ease-in-out infinite alternate;
  }
  .spatial-orbit {
    animation: spatial-spin 9s linear infinite;
  }
  .spatial-fill {
    width: 64%;
    animation: spatial-fill 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both;
  }
}

@keyframes spatial-in {
  from {
    opacity: 0;
    transform: translateZ(-220px) scale(0.92);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes spatial-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}
@keyframes spatial-spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes spatial-zoom {
  from {
    transform: scale(1.04);
  }
  to {
    transform: scale(1.14) translate(-2%, 1%);
  }
}
@keyframes spatial-fill {
  from {
    width: 0%;
  }
}
