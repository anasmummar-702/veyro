"use client"

import Link from "next/link"
import { useRouter } from "next/navigation"
import { useCallback, useEffect, useRef, useState } from "react"
import { getBrowserClient } from "@/lib/supabase/client"
import { PlaybackTracker } from "@/lib/playback-tracker"
import { YT_STATE, loadYouTubeApi, type YTPlayer } from "@/lib/youtube"
import { formatClock } from "@/lib/format"
import { CheckIcon } from "@/components/icons"

const FLUSH_EVERY_MS = 10_000
const SAMPLE_EVERY_MS = 1_000
const COMPLETE_AT = 0.85

type Status = "loading" | "ready" | "unavailable" | "blocked"

export function VideoLesson({
  lessonId,
  videoRef,
  durationSec,
  resumeAt,
  watchedSec: initialWatched,
  completed: initiallyCompleted,
  trackable,
  courseHref,
  nextHref,
}: {
  lessonId: string
  videoRef: string
  durationSec: number
  resumeAt: number
  watchedSec: number
  completed: boolean
  trackable: boolean
  courseHref: string
  nextHref: string | null
}) {
  const router = useRouter()
  const mountRef = useRef<HTMLDivElement>(null)
  const playerRef = useRef<YTPlayer | null>(null)
  const trackerRef = useRef(new PlaybackTracker())
  const sendingRef = useRef(false)
  const [status, setStatus] = useState<Status>("loading")
  const [watched, setWatched] = useState(initialWatched)
  const [completed, setCompleted] = useState(initiallyCompleted)
  const [ended, setEnded] = useState(false)
  const [saveError, setSaveError] = useState(false)

  const flush = useCallback(async () => {
    if (!trackable || sendingRef.current) return
    const tracker = trackerRef.current
    const intervals = tracker.drain()
    if (!intervals.length) return
    sendingRef.current = true
    try {
      const player = playerRef.current
      const { data, error } = await getBrowserClient().rpc("record_video_progress", {
        p_lesson_id: lessonId,
        p_intervals: intervals,
        p_position: tracker.position,
        p_player_duration: player ? Math.round(player.getDuration()) || undefined : undefined,
      })
      if (error) throw error
      const result = data as { accepted: boolean; watched_sec: number; is_completed: boolean; just_completed: boolean }
      setSaveError(false)
      setWatched(result.watched_sec)
      if (result.is_completed) setCompleted(true)
      if (result.just_completed) router.refresh()
    } catch {
      trackerRef.current.restore(intervals)
      setSaveError(true)
    } finally {
      sendingRef.current = false
    }
  }, [lessonId, router, trackable])

  useEffect(() => {
    let cancelled = false
    let sampleTimer: number | undefined
    let flushTimer: number | undefined
    const tracker = trackerRef.current

    const startSampling = () => {
      window.clearInterval(sampleTimer)
      sampleTimer = window.setInterval(() => {
        const p = playerRef.current
        if (p && p.getPlayerState() === YT_STATE.PLAYING) tracker.sample(p.getCurrentTime())
      }, SAMPLE_EVERY_MS)
    }

    loadYouTubeApi()
      .then((YT) => {
        if (cancelled || !mountRef.current) return
        const start = resumeAt > 5 && resumeAt < durationSec - 15 ? Math.floor(resumeAt) : 0
        playerRef.current = new YT.Player(mountRef.current, {
          videoId: videoRef,
          host: "https://www.youtube-nocookie.com",
          playerVars: { start, rel: 0, playsinline: 1, origin: window.location.origin },
          events: {
            onReady: () => !cancelled && setStatus("ready"),
            onError: () => !cancelled && setStatus("unavailable"),
            onStateChange: (e) => {
              if (e.data === YT_STATE.PLAYING) {
                setEnded(false)
                tracker.sample(e.target.getCurrentTime())
                startSampling()
              } else {
                tracker.sample(e.target.getCurrentTime())
                tracker.stop()
                window.clearInterval(sampleTimer)
                if (e.data === YT_STATE.PAUSED || e.data === YT_STATE.ENDED) void flush()
                if (e.data === YT_STATE.ENDED) setEnded(true)
              }
            },
          },
        })
        flushTimer = window.setInterval(() => void flush(), FLUSH_EVERY_MS)
      })
      .catch(() => !cancelled && setStatus("blocked"))

    const onHide = () => {
      if (document.visibilityState === "hidden") void flush()
    }
    document.addEventListener("visibilitychange", onHide)

    return () => {
      cancelled = true
      document.removeEventListener("visibilitychange", onHide)
      window.clearInterval(sampleTimer)
      window.clearInterval(flushTimer)
      tracker.stop()
      void flush()
      playerRef.current?.destroy()
      playerRef.current = null
    }
  }, [videoRef, resumeAt, durationSec, flush])

  const required = Math.ceil(durationSec * COMPLETE_AT)
  const pct = durationSec > 0 ? Math.min(100, Math.round((watched / required) * 100)) : 0

  return (
    <div>
      <div className="relative aspect-video overflow-hidden rounded-lg bg-black">
        <div ref={mountRef} className="absolute inset-0 h-full w-full [&>iframe]:h-full [&>iframe]:w-full" />
        {status === "loading" && (
          <div className="absolute inset-0 flex flex-col items-center justify-center gap-3 text-sm text-white/80" aria-live="polite">
            <span className="h-8 w-8 animate-spin rounded-full border-2 border-white/20 border-t-white" />
            Loading video
          </div>
        )}
        {(status === "unavailable" || status === "blocked") && (
          <div className="absolute inset-0 flex items-center justify-center bg-[#1f1f1f] p-6 text-center text-white" role="alert">
            <div className="max-w-md">
              <p className="text-lg font-semibold">
                {status === "unavailable" ? "This video can\u2019t be played right now" : "The video player didn\u2019t load"}
              </p>
              <p className="mt-2 text-sm leading-relaxed text-white/80">
                {status === "unavailable"
                  ? "It may have been removed or restricted by its creator. You can go to the next item while the course is updated."
                  : "Check your connection, or allow youtube.com and youtube-nocookie.com if you use a content blocker, then reload the page."}
              </p>
              {nextHref && (
                <Link href={nextHref} className="btn btn-white mt-5">
                  Go to next item
                </Link>
              )}
            </div>
          </div>
        )}
      </div>

      {trackable ? (
        <div className="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
          {completed ? (
            <p className="flex items-center gap-2 font-semibold text-success" role="status">
              <span className="flex h-6 w-6 items-center justify-center rounded-full bg-success text-white">
                <CheckIcon className="h-3.5 w-3.5" />
              </span>
              Completed
            </p>
          ) : (
            <div className="min-w-[14rem] flex-1">
              <div className="flex items-center justify-between gap-4 text-sm text-muted">
                <span>
                  Watched <span className="font-semibold text-ink">{formatClock(watched)}</span> of {formatClock(durationSec)}
                </span>
                <span>Completes at {Math.round(COMPLETE_AT * 100)}% watched</span>
              </div>
              <div className="mt-2 h-1.5 max-w-full overflow-hidden rounded-full bg-[#e5e9f0]">
                <div className="h-full rounded-full bg-brand transition-[width] duration-500" style={{ width: `${pct}%` }} />
              </div>
            </div>
          )}
          {saveError && (
            <p className="w-full text-sm font-semibold text-danger" role="alert">
              Progress isn&rsquo;t saving right now. We&rsquo;ll keep trying while you watch.
            </p>
          )}
          {completed && ended && nextHref && (
            <Link href={nextHref} className="btn btn-primary ml-auto">
              Go to next item
            </Link>
          )}
        </div>
      ) : (
        <div className="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-lg bg-brand-50 p-4">
          <p>You&rsquo;re previewing this item. Enroll to save your progress.</p>
          <Link href={courseHref} className="btn btn-primary">
            Enroll for free
          </Link>
        </div>
      )}
    </div>
  )
}
