  {
    title: "Subjects",
    links: [
      ["/courses?category=data-ai", "Data & AI"],
      ["/courses?category=mathematics", "Mathematics"],
      ["/courses?category=learning-skills", "Learning skills"],
      ["/courses", "All courses"],
    ],
  },
  {
    title: "Veyro",
    links: [
      ["/#mission", "About us"],
      ["/#services", "What we offer"],
      ["/#roadmap", "What we're building"],
      ["/#roadmap", "Teach on Veyro"],
    ],
  },
  {
    title: "Learners",
    links: [
      ["/sign-up", "Join for free"],
      ["/sign-in", "Log in"],
      ["/my-learning", "My Learning"],
      ["/account", "Account settings"],
    ],
  },
]

export function SiteFooter() {
  return (
    <footer className="mt-24 border-t border-line bg-soft">
      <div className="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
        <div>
          <Wordmark />
          <p className="mt-4 max-w-xs text-sm leading-relaxed text-muted">
            Structured online courses built around the clearest lectures, with notes, practice and saved progress.
          </p>
        </div>
        {FOOTER.map((col) => (
          <nav key={col.title} aria-label={col.title}>
            <p className="font-semibold">{col.title}</p>
            <ul className="mt-4 space-y-2.5 text-sm">
              {col.links.map(([href, label]) => (
                <li key={label}>
                  <Link href={href} className="text-muted hover:text-ink hover:underline">
                    {label}
                  </Link>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <div className="border-t border-line">
        <p className="mx-auto max-w-7xl px-4 py-6 text-sm text-muted sm:px-6">
          © {COPYRIGHT_YEAR} Veyro. Videos are embedded from their original creators and credited on every lesson.
        </p>
      </div>
    </footer>
  )
}

const COPYRIGHT_YEAR = 2026
