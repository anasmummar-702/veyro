// ---------------------------------------------------------------- sections

async function HeroOrWelcome() {
  const user = await getCurrentUser()
  if (!user) return <HeroSignedOut />
  const mine = await listMyCourses(user.id)
  const current = mine.find((m) => m.status === "active")

  return (
    <section className="border-b border-line bg-gradient-to-b from-brand-50 to-white">
      <div className="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <h1 className="h-display !text-[clamp(1.9rem,1.4rem+2vw,2.75rem)]">Welcome back, {firstName(user)}</h1>
        {current ? (
          <div className="card mt-6 grid items-center gap-5 p-4 sm:grid-cols-[200px_minmax(0,1fr)_auto] sm:p-5">
            <div className="aspect-[16/9] overflow-hidden rounded-md">
              <CourseCover motif={current.course.coverMotif} tone={current.course.coverTone} seed={current.course.slug} rounded={false} />
            </div>
            <div className="min-w-0">
              <p className="text-sm text-muted">Continue learning</p>
              <p className="mt-0.5 text-xl font-semibold">{current.course.title}</p>
              {current.lastLessonTitle && <p className="mt-1 truncate text-muted">{current.lastLessonTitle}</p>}
              <div className="mt-3 flex max-w-md items-center gap-3">
                <ProgressBar className="flex-1" done={current.done} total={current.total} />
                <span className="text-sm text-muted">{current.total ? Math.round((current.done / current.total) * 100) : 0}%</span>
              </div>
            </div>
            <Link href={current.resumeHref} className="btn btn-primary">
              Resume
            </Link>
          </div>
        ) : (
          <p className="mt-3 text-lg text-muted">
            Ready to start something new?{" "}
            <Link href="/courses" className="link">
              Browse courses
            </Link>
          </p>
        )}
      </div>
    </section>
  )
}

function HeroSignedOut() {
  return (
    <section className="overflow-hidden">
      <div className="mx-auto grid max-w-7xl items-center gap-12 px-4 pb-16 pt-12 sm:px-6 md:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div>
          <h1 className="h-display max-w-[13ch]">Learn skills that last, at your own pace</h1>
          <p className="mt-5 max-w-[46ch] text-xl leading-relaxed text-muted">
            Structured courses built around the clearest lectures, with notes, practice and progress saved on every
            lesson.
          </p>
          <div className="mt-8 flex flex-wrap gap-3">
            <Link href="/sign-up" className="btn btn-primary btn-lg">
              Join for Free
            </Link>
            <Link href="/courses" className="btn btn-outline btn-lg">
              Explore courses
            </Link>
          </div>
          <p className="mt-5 flex items-center gap-2 text-sm text-muted">
            <CheckIcon className="h-4 w-4 text-success" />
            All courses are free during early access
          </p>
        </div>

        <SpatialHero />
      </div>
    </section>
  )
}

async function Stats() {
  const [courses, categories] = await Promise.all([listCourses(), listCategories()])
  const lessons = courses.reduce((s, c) => s + c.lessonCount, 0)
  const seconds = courses.reduce((s, c) => s + c.durationSec, 0)
  const stats = [
    [String(courses.length), "courses to choose from"],
    [String(lessons), "video and reading lessons"],
    [formatDuration(seconds), "of learning content"],
    [String(categories.length), "subjects"],
  ]
  return (
    <section className="border-y border-line bg-soft">
      <dl className="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-8 sm:px-6 md:grid-cols-4">
        {stats.map(([value, label]) => (
          <div key={label}>
            <dt className="sr-only">{label}</dt>
            <dd>
              <span className="block text-3xl font-semibold text-brand">{value}</span>
              <span className="mt-0.5 block text-muted">{label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

async function Categories() {
  const [categories, courses] = await Promise.all([listCategories(), listCourses()])
  const icons = [ChartIcon, TargetIcon, ReadIcon, LayersIcon]
  return (
    <div className="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((c, i) => {
        const Icon = icons[i % icons.length]
        const count = courses.filter((x) => x.category?.slug === c.slug).length
        return (
          <Link key={c.slug} href={`/courses?category=${c.slug}`} className="card card-hover flex items-center gap-4 p-4">
            <span className="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand">
              <Icon className="h-6 w-6" />
            </span>
            <span>
              <span className="block font-semibold">{c.name}</span>
              <span className="block text-sm text-muted">{count === 1 ? "1 course" : `${count} courses`}</span>
            </span>
          </Link>
        )
      })}
      <Link href="/courses" className="card card-hover flex items-center justify-between gap-4 p-4">
        <span className="font-semibold text-brand">View all courses</span>
        <ArrowRightIcon className="h-5 w-5 text-brand" />
      </Link>
    </div>
  )
}

async function PopularCourses() {
  const courses = await listCourses()
  if (!courses.length) return <p className="text-muted">No courses are published yet. Check back soon.</p>
  return (
    <div className="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {courses.slice(0, 8).map((c, i) => (
        <CourseCard key={c.id} course={c} priority={i < 4} />
      ))}
    </div>
  )
}
