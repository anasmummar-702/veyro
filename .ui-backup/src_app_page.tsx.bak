      </section>

      <section className="mx-auto mt-20 w-full max-w-7xl px-4 sm:px-6">
        <div className="relative overflow-hidden rounded-xl bg-brand px-6 py-12 text-white sm:px-12">
          <div aria-hidden="true" className="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-white/10" />
