      <section id="courses" className="mx-auto w-full max-w-7xl scroll-mt-28 px-4 pt-16 sm:px-6">
        <div className="flex items-end justify-between gap-4">
          <div>
            <h2 className="h-section">Most popular courses</h2>
            <p className="mt-1 text-muted">Start learning today. Every course is free.</p>
          </div>
          <Link href="/courses" className="link hidden shrink-0 sm:block">
