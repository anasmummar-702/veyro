@import "tailwindcss";

/*
  Veyro — premium blue & white theme
  brand      #0056d2  royal blue (primary)     brand-dark   #0041a8  pressed / deep blue
  navy       #0a1f44  deep navy (footer)       navy-deep    #061633
  brand-50   #f3f7ff  tinted sections          brand-100    #e4eeff   brand-200 #c7dbff
  accent     #2f7bff  bright highlight         accent-light #a8c8ff   accent-dark #0047b3
  ink        #0b1736  text                     muted        #56637d
  line       #e3e9f3  borders                  soft         #f6f8fc   canvas    #ffffff
  success    #12805c  completion               danger       #c4122f
*/
@theme {
  --color-brand: #0056d2;
  --color-brand-dark: #0041a8;
  --color-navy: #0a1f44;
  --color-navy-deep: #061633;
  --color-brand-50: #f3f7ff;
  --color-brand-100: #e4eeff;
  --color-brand-200: #c7dbff;
  --color-accent: #2f7bff;
  --color-accent-light: #a8c8ff;
  --color-accent-dark: #0047b3;
  --color-ink: #0b1736;
  --color-muted: #56637d;
  --color-line: #e3e9f3;
  --color-soft: #f6f8fc;
  --color-canvas: #ffffff;
  --color-success: #12805c;
  --color-success-50: #e7f6ef;
  --color-danger: #c4122f;

  --font-sans: "Source Sans 3 Variable", "Source Sans Pro", ui-sans-serif, system-ui, sans-serif;
  --font-serif: var(--font-instrument), "Instrument Serif", Georgia, serif;
  --font-display: var(--font-jakarta), "Plus Jakarta Sans Variable", "Source Sans 3 Variable", ui-sans-serif, system-ui, sans-serif;
}

@layer base {
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    background: var(--color-canvas);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
    letter-spacing: -0.015em;
  }
  ::selection {
    background: var(--color-brand-100);
    color: var(--color-navy);
  }
  :focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

@layer components {
  .h-display {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 1.6rem + 3.6vw, 4.6rem);
    line-height: 1.08;
    font-weight: 750;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .h-section {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.35rem + 1.5vw, 2.6rem);
    line-height: 1.12;
    font-weight: 750;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .font-display {
    font-family: var(--font-display);
  }
  /* Highlighted words in headings */
  .text-accent-gradient {
    font-style: normal;
    background: linear-gradient(100deg, #0056d2 0%, #2f7bff 55%, #5aa2ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .text-accent-gradient-light {
    font-style: normal;
    background: linear-gradient(100deg, #ffffff 0%, #cfe0ff 50%, #8fb8ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem 0.3rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand);
    background: var(--color-brand-50);
    border: 1px solid var(--color-brand-100);
  }
  .eyebrow::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: currentColor;
    box-shadow: 0 0 0 3px rgb(0 86 210 / 0.15);
  }
  /* Thin rule + small caps label, used in the hero */
  .eyebrow-line {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a6a32;
  }
  .eyebrow-line::before {
    content: "";
    width: 2.6rem;
    height: 1px;
    background: currentColor;
    opacity: 0.8;
  }
  /* Elegant italic serif highlight inside sans headings */
  .text-serif-accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.1em;
    line-height: 0.9;
    letter-spacing: -0.01em;
    margin-right: -0.06em;
    color: #2257d6;
  }
  .eyebrow-light {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.2);
  }
  .eyebrow-light::before {
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.2);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.4rem;
    border-radius: 9999px;
    font-weight: 650;
    font-size: 1rem;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }
  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .btn-primary {
    background: linear-gradient(180deg, #1a2d5c 0%, #0c1a3c 100%);
    color: #fff;
    border: 1px solid #0a1633;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 1px 2px rgb(10 22 51 / 0.3),
      0 12px 26px -12px rgb(10 22 51 / 0.65);
  }
  .btn-primary:hover:not(:disabled) {
    background: linear-gradient(180deg, #1f3a78 0%, #0f2350 100%);
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.16),
      0 1px 2px rgb(10 22 51 / 0.3),
      0 18px 32px -14px rgb(10 22 51 / 0.7);
  }
  /* Kept as an alias so older markup keeps working */
  .btn-gold {
    background: linear-gradient(180deg, #1a6ce6 0%, var(--color-brand) 100%);
    color: #fff;
    border: 1px solid var(--color-brand-dark);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 8px 20px -8px rgb(0 86 210 / 0.55);
  }
  .btn-gold:hover:not(:disabled) {
    background: var(--color-brand-dark);
    transform: translateY(-1px);
  }
  .btn-outline {
    background: rgb(255 255 255 / 0.6);
    color: var(--color-navy);
    border: 1px solid #cfd5df;
  }
  .btn-outline:hover:not(:disabled) {
    border-color: var(--color-navy);
    background: #fff;
  }
  .btn-ghost-light {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.3);
  }
  .btn-ghost-light:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.16);
    border-color: rgb(255 255 255 / 0.6);
  }
  .btn-white {
    background: #fff;
    color: var(--color-brand);
    border: 1px solid #fff;
    box-shadow: 0 10px 30px -10px rgb(6 22 51 / 0.5);
  }
  .btn-white:hover:not(:disabled) {
    background: var(--color-brand-50);
    transform: translateY(-1px);
  }
  .btn-lg {
    min-height: 3.25rem;
    min-height: 4rem;
    padding: 0.85rem 2.25rem;
    font-size: 1.15rem;
  }

  .card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 1.1rem;
    box-shadow:
      0 1px 2px rgb(11 23 54 / 0.04),
      0 10px 30px -18px rgb(11 23 54 / 0.18);
  }
  .card-hover {
    transition:
      box-shadow 240ms ease,
      border-color 240ms ease,
      transform 240ms ease;
  }
  .card-hover:hover {
    border-color: var(--color-brand-200);
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px rgb(11 23 54 / 0.05),
      0 28px 50px -24px rgb(0 65 168 / 0.35);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    padding: 0.4rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    background: #fff;
    border: 1px solid #d3dbe8;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .chip:hover {
    background: var(--color-brand-50);
    border-color: var(--color-brand-200);
  }
  .chip[aria-current="true"] {
    color: #fff;
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  .field {
    display: block;
    width: 100%;
    min-height: 2.9rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid #cfd8e6;
    background: #fff;
    color: var(--color-ink);
    font-size: 1rem;
    transition:
      border-color 120ms ease,
      box-shadow 120ms ease;
  }
  .field::placeholder {
    color: #6b7690;
  }
  .field:hover {
    border-color: #b5c3da;
  }
  .field:focus-visible {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 4px rgb(0 86 210 / 0.15);
  }
  .field-label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .link {
    color: var(--color-brand);
    font-weight: 600;
  }
  .link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .skeleton {
    background: linear-gradient(90deg, #eef2f8, #f8fafd, #eef2f8);
    background-size: 200% 100%;
    animation: shimmer 1.5s linear infinite;
    border-radius: 0.5rem;
  }
  @keyframes shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  /* Reading lessons */
  .prose-reading {
    font-size: 1.1rem;
    line-height: 1.75;
    color: #2a344a;
    max-width: 72ch;
  }
  .prose-reading > * + * {
    margin-top: 1em;
  }
  .prose-reading h2 {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 1.8em;
    color: var(--color-ink);
  }
  .prose-reading h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1.5em;
    color: var(--color-ink);
  }
  .prose-reading ul,
  .prose-reading ol {
    padding-left: 1.4em;
  }
  .prose-reading ul {
    list-style: disc;
  }
  .prose-reading ol {
    list-style: decimal;
  }
  .prose-reading li + li {
    margin-top: 0.4em;
  }
  .prose-reading strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .prose-reading a {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .prose-reading pre {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.92rem;
    line-height: 1.55;
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    padding: 1rem 1.15rem;
    overflow-x: auto;
  }
  .prose-reading code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
  .prose-reading table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .prose-reading th,
  .prose-reading td {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-line);
  }
  .prose-reading th {
    font-weight: 600;
    background: var(--color-soft);
  }
}

/* ---------------------------------------------------------------- spatial hero */
@layer components {
  .spatial-stage {
    perspective: 1100px;
    perspective-origin: 50% 45%;
  }
  .spatial-scene {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 50%;
    --gy: 40%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    will-change: transform;
  }
  .spatial-layer {
    transform-style: preserve-3d;
    transform: translateZ(var(--z, 0px));
  }
  .spatial-in {
    transform-style: preserve-3d;
    animation: spatial-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .spatial-glass {
    color: var(--color-ink);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.97), rgb(255 255 255 / 0.88));
    border: 1px solid rgb(255 255 255 / 0.95);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 0 0 1px rgb(11 23 54 / 0.05),
      0 24px 48px -14px rgb(0 65 168 / 0.35);
    backdrop-filter: blur(16px) saturate(170%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
  }
  .spatial-glare {
    background: radial-gradient(circle at var(--gx) var(--gy), rgb(255 255 255 / 0.35), transparent 45%);
    mix-blend-mode: soft-light;
  }
  .spatial-float-a {
    animation: spatial-float 6s ease-in-out infinite;
  }
  .spatial-float-b {
    animation: spatial-float 7.5s ease-in-out -2s infinite;
  }
  .spatial-float-c {
    animation: spatial-float 9s ease-in-out -4s infinite;
  }
  .spatial-spin {
    animation: spatial-spin 80s linear infinite;
  }
  .spatial-photo {
    animation: spatial-zoom 18s ease-in-out infinite alternate;
  }
  .spatial-orbit {
    animation: spatial-spin 9s linear infinite;
  }
  .spatial-fill {
    width: 64%;
    animation: spatial-fill 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both;
  }
}

@keyframes spatial-in {
  from {
    opacity: 0;
    transform: translateZ(-220px) scale(0.92);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes spatial-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}
@keyframes spatial-spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes spatial-zoom {
  from {
    transform: scale(1.04);
  }
  to {
    transform: scale(1.14) translate(-2%, 1%);
  }
}
@keyframes spatial-fill {
  from {
    width: 0%;
  }
}

/* ---------------------------------------------------------------- premium surfaces */
@layer components {
  /* Bright hero: white with soft blue light and a faint grid */
  .surface-hero {
    position: relative;
    background:
      radial-gradient(40rem 28rem at 80% 20%, rgb(120 160 240 / 0.1), transparent 65%),
      linear-gradient(180deg, #faf9f7 0%, #f8f7f5 100%);
  }
  /* Rich royal-blue band (CTA, stats) */
  .surface-blue {
    position: relative;
    color: #fff;
    background:
      radial-gradient(40rem 22rem at 90% 0%, rgb(120 175 255 / 0.45), transparent 60%),
      radial-gradient(30rem 20rem at 0% 100%, rgb(0 40 120 / 0.55), transparent 60%),
      linear-gradient(135deg, #0047b8 0%, #0056d2 50%, #1f6ff0 100%);
  }
  .surface-blue::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at 80% 20%, #000 15%, transparent 70%);
  }
  /* Deep navy (footer) */
  .surface-midnight {
    position: relative;
    color: #fff;
    background:
      radial-gradient(50rem 26rem at 85% -20%, rgb(47 123 255 / 0.28), transparent 60%),
      linear-gradient(180deg, #0a1f44 0%, #061633 100%);
  }
  .hairline-blue {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(120 170 255 / 0.7), transparent);
  }
  .icon-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.85rem;
    color: var(--color-brand);
    background: linear-gradient(145deg, #f1f6ff, #dde9ff);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 0 0 1px rgb(0 86 210 / 0.14);
  }
  .icon-tile-solid {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.85rem;
    color: #fff;
    background: linear-gradient(145deg, #2f7bff, #0047b8);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 10px 20px -8px rgb(0 86 210 / 0.6);
  }
}

/* ---------------------------------------------------------------- hero entrance */
@layer components {
  .hero-pop {
    animation: hero-pop 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-fade {
    animation: hero-fade 1.2s ease both;
  }
}
@keyframes hero-pop {
  from {
    opacity: 0;
    translate: 0 14px;
    scale: 0.96;
  }
}
@keyframes hero-fade {
  from {
    opacity: 0;
  }
}

/* Full-screen pages (sign in, sign up) hide the site footer. */
body:has([data-no-footer]) .site-footer {
  display: none;
}
