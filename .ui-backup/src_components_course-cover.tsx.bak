import type { CoverMotif, CoverTone } from "@/lib/data"

// Each tone: deep gradient + one luminous accent used for the "lit" path.
const TONES: Record<CoverTone, { from: string; to: string; glow: string; solid: string }> = {
  lapis: { from: "#2433a8", to: "#070b24", glow: "#7dd3fc", solid: "#1a2477" },
  ink: { from: "#4c1fb0", to: "#0b061d", glow: "#c4b5fd", solid: "#2e1572" },
  moss: { from: "#0f6b5f", to: "#03121a", glow: "#5eead4", solid: "#0b4a43" },
  plum: { from: "#8c2275", to: "#14051a", glow: "#f9a8d4", solid: "#5c1650" },
  rust: { from: "#9a4512", to: "#160803", glow: "#fdba74", solid: "#6a2f0c" },
}
const W = 400
const H = 240

function rng(seed: string) {
  let h = 2166136261
  for (let i = 0; i < seed.length; i++) h = Math.imul(h ^ seed.charCodeAt(i), 16777619)
  return () => {
    h += 0x6d2b79f5
    let t = h
    t = Math.imul(t ^ (t >>> 15), t | 1)
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61)
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

// Each motif creates its own generator from the seed, so every render (server, client,
// and React's dev double-render) draws exactly the same picture.
type MotifProps = { seed: string; glow: string; fid: string }

function Network({ seed, glow, fid }: MotifProps) {
  const r = rng(seed)
  const layers = [3, 5, 5, 2].map((count, li) => {
    const x = 70 + li * 90
    const gap = 180 / (count + 1)
    return Array.from({ length: count }, (_, i) => ({ x, y: 30 + gap * (i + 1) + (r() - 0.5) * 8 }))
  })
  const path = layers.map((nodes) => nodes[Math.floor(r() * nodes.length)])
  return (
    <g>
      {layers.slice(0, -1).map((nodes, li) =>
        nodes.flatMap((a, i) =>
          layers[li + 1].map((b, j) => (
            <line key={`${li}-${i}-${j}`} x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke="#fff" strokeOpacity={0.06 + r() * 0.12} />
          )),
        ),
      )}
      <polyline points={path.map((p) => `${p.x},${p.y}`).join(" ")} fill="none" stroke={glow} strokeWidth={2.5} strokeLinejoin="round" filter={`url(#${fid})`} />
      {layers.flat().map((n, i) => (
        <circle key={i} cx={n.x} cy={n.y} r={6} fill="#0b0d18" fillOpacity={0.6} stroke="#fff" strokeOpacity={0.55} strokeWidth={1.3} />
      ))}
      {path.map((n, i) => (
        <circle key={`p${i}`} cx={n.x} cy={n.y} r={6.5} fill={glow} filter={`url(#${fid})`} />
      ))}
    </g>
  )
}

function Grid({ seed, glow, fid }: MotifProps) {
  const r = rng(seed)
  const k = 0.35 + r() * 0.4
  const t = (x: number, y: number) => [200 + (x + k * y) * 34, 140 - (0.15 * x + y) * 34] as const
  const lines = []
  for (let i = -8; i <= 8; i++) {
    const [ax, ay] = t(i, -6)
    const [bx, by] = t(i, 6)
    const [cx, cy] = t(-9, i)
    const [dx, dy] = t(9, i)
    lines.push(<line key={`v${i}`} x1={ax} y1={ay} x2={bx} y2={by} stroke="#fff" strokeOpacity={i === 0 ? 0.4 : 0.09} />)
    lines.push(<line key={`h${i}`} x1={cx} y1={cy} x2={dx} y2={dy} stroke="#fff" strokeOpacity={i === 0 ? 0.4 : 0.09} />)
  }
  const [ox, oy] = t(0, 0)
  const [ix, iy] = t(1, 0)
  const [px, py] = t(1 + Math.floor(r() * 2), 1 + Math.floor(r() * 2))
  return (
    <g>
      {lines}
      <line x1={ox} y1={oy} x2={ix} y2={iy} stroke="#fff" strokeOpacity={0.85} strokeWidth={2.5} />
      <line x1={ox} y1={oy} x2={px} y2={py} stroke={glow} strokeWidth={3} strokeLinecap="round" filter={`url(#${fid})`} />
      <circle cx={px} cy={py} r={6} fill={glow} filter={`url(#${fid})`} />
      <circle cx={ox} cy={oy} r={3.5} fill="#fff" />
    </g>
  )
}

function Curve({ seed, glow, fid }: MotifProps) {
  const r = rng(seed)
  const a = 0.6 + r() * 0.5
  const b = 1.4 + r() * 1.2
  const f = (x: number) => 150 - 55 * Math.sin((x / W) * Math.PI * a + 0.4) - 18 * Math.sin((x / W) * Math.PI * b)
  const pts = Array.from({ length: 81 }, (_, i) => [(i / 80) * W, f((i / 80) * W)] as const)
  const area = pts.filter(([x]) => x >= 90 && x <= 230)
  const x0 = 250 + r() * 60
  const slope = f(x0 + 0.5) - f(x0 - 0.5)
  const span = 95
  return (
    <g>
      <line x1={0} y1={205} x2={W} y2={205} stroke="#fff" strokeOpacity={0.2} />
      <path
        d={`M${area[0][0]},205 ${area.map(([x, y]) => `L${x.toFixed(1)},${y.toFixed(1)}`).join(" ")} L${area[area.length - 1][0]},205 Z`}
        fill={glow}
        fillOpacity={0.14}
      />
      <polyline points={pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ")} fill="none" stroke="#fff" strokeOpacity={0.85} strokeWidth={2} />
      <line x1={x0 - span} y1={f(x0) - slope * span} x2={x0 + span} y2={f(x0) + slope * span} stroke={glow} strokeWidth={2.5} strokeLinecap="round" filter={`url(#${fid})`} />
      <circle cx={x0} cy={f(x0)} r={6} fill={glow} filter={`url(#${fid})`} />
    </g>
  )
}

function Lines({ seed, glow, fid }: MotifProps) {
  const r = rng(seed)
  const rows = Array.from({ length: 9 }, (_, i) => ({ y: 34 + i * 21, w: 150 + r() * 190 }))
  const hl = 2 + Math.floor(r() * 5)
  return (
    <g>
      {rows.map((row, i) => (
        <rect
          key={i}
          x={40}
          y={row.y - 3}
          width={row.w}
          height={6}
          rx={3}
          fill={i === hl ? glow : "#fff"}
          fillOpacity={i === hl ? 1 : 0.16}
          filter={i === hl ? `url(#${fid})` : undefined}
        />
      ))}
    </g>
  )
}

function Orbit({ seed, glow, fid }: MotifProps) {
  const r = rng(seed)
  return (
    <g>
      {[0, 1, 2, 3].map((i) => (
        <ellipse key={i} cx={200} cy={120} rx={50 + i * 40} ry={22 + i * 18} fill="none" stroke="#fff" strokeOpacity={0.16} transform={`rotate(${-12 + r() * 6} 200 120)`} />
      ))}
      <circle cx={200} cy={120} r={9} fill="#fff" />
      <circle cx={200 + 130 * Math.cos(r() * 6)} cy={120 + 58 * Math.sin(r() * 6)} r={7} fill={glow} filter={`url(#${fid})`} />
    </g>
  )
}

export function CourseCover({
  motif,
  tone,
  seed,
  className = "",
  rounded = true,
  instance = "",
}: {
  motif: CoverMotif
  tone: CoverTone
  seed: string
  className?: string
  rounded?: boolean
  /** Distinguishes SVG ids when the same course cover appears twice on a page. */
  instance?: string
}) {
  const t = TONES[tone] ?? TONES.lapis
  const id = `cv-${seed.replace(/[^a-z0-9]/gi, "")}-${motif}${instance ? `-${instance.replace(/[^a-z0-9]/gi, "")}` : ""}`
  const Motif = { network: Network, grid: Grid, curve: Curve, lines: Lines, orbit: Orbit }[motif] ?? Grid
  return (
    <svg
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid slice"
      className={`block h-full w-full ${rounded ? "rounded-xl" : ""} ${className}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stopColor={t.from} />
          <stop offset="1" stopColor={t.to} />
        </linearGradient>
        <radialGradient id={`${id}-light`} cx="0.15" cy="0" r="0.9">
          <stop offset="0" stopColor="#fff" stopOpacity="0.18" />
          <stop offset="1" stopColor="#fff" stopOpacity="0" />
        </radialGradient>
        <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="4" result="b" />
          <feMerge>
            <feMergeNode in="b" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      <rect width={W} height={H} fill={`url(#${id}-bg)`} />
      <rect width={W} height={H} fill={`url(#${id}-light)`} />
      <Motif seed={seed} glow={t.glow} fid={`${id}-glow`} />
    </svg>
  )
}

export const toneColor = (tone: CoverTone) => (TONES[tone] ?? TONES.lapis).solid
export const toneGlow = (tone: CoverTone) => (TONES[tone] ?? TONES.lapis).glow
